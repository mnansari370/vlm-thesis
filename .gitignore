# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Environments
.venv/
venv/
.env
*.egg-info/

# Large data — all datasets are local-only (downloadable / regenerable).
# Anchored to repo root so it ignores ONLY the top-level data/ dir, not src/data/ or scripts/data/.
/data/
*.zip
*.tar
*.tar.gz

# Training outputs
outputs/
logs/
wandb/
runs/
feature_cache/

# Results: the per-cell run outputs under results/runs/ are large and local-only (ignored).
# The committed evidence — the summary tables, the fitted controller configs, the top-level
# index docs, and the per-method result index READMEs — is tracked via the negations below.
/results/*
!/results/README.md
!/results/INDEX.md
!/results/legacy_index.md
!/results/tables/
!/results/configs/
!/results/dense/
!/results/static/
!/results/dynamic_which/
!/results/dynamic_count/

# VQAv2 outputs and caches (large, generated locally) — old + new path names
vqa_v2/outputs/
vqa_v2/logs/
vqa_v2/feature_cache/
vqa_v2/feature_cache_smoke/
VQA_V2/outputs/
VQA_V2/logs/
VQA_V2/feature_cache/
VQA_V2/feature_cache_smoke/

# GQA experiment outputs (large, generated locally)
GQA/outputs/
VQA_V2_early_proxy/outputs/
VQA_V2_early_proxy/logs/


# Cloned external repos
external/

# Checkpoints / model weights
*.pt
*.pth
*.ckpt
*.safetensors

# Backup files
*.bak

# System
.DS_Store

# Editor / tooling config (local-only, never pushed)
.vscode/
.claude/

# Private research material — local-only, never pushed (docs = internal planning/reports,
# literature = paper notes). They remain on disk and in local branch history.
docs/
literature/

# Archived/superseded material (2026-06-27 scope lock).
# Policy: TRACK archived code / docs / manifests so deletions from the active tree have
# matching archived copies in git; DO NOT track large data / results / checkpoints.
# (Negation works because each tracked subtree is re-included before its contents are seen;
#  global binary ignores above — *.pt/*.zip/etc. — still apply inside the tracked subtrees.)
archive/*
!archive/migration_manifests/
!archive/legacy_models/
!archive/legacy_experiments/
!archive/legacy_scripts/
!archive/legacy_docs/
!archive/legacy_datasets/
# the bare `literature/` rule above (private active notes) over-matches the ARCHIVED copy at
# any depth; re-include it so archived legacy docs are trackable (markdown only, reviewed clean).
!archive/legacy_docs/docs/literature/
# within legacy_datasets, track only source code (loaders), never the data blobs
archive/legacy_datasets/*
!archive/legacy_datasets/src/
# never track archived results / checkpoints / dataset binaries
archive/legacy_results/
